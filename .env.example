# Copy this file to .env.development for local development.
# Production values belong in the Render dashboard, never in the repository.

# Required
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-64-character-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-string
CLIENT_URL=http://localhost:5173

# Server
PORT=5000
NODE_ENV=development
OWNER_EMAIL=you@example.com
FROM_EMAIL=you@example.com
WHATSAPP_NUMBER=8801XXXXXXXXX
MESSENGER_PAGE=
BREVO_NEWSLETTER_LIST_ID=

# Email
BREVO_API_KEY=

# Image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reverse proxy (set to 1 on Render)
TRUST_PROXY_HOPS=

# Optional first-run admin bootstrap. Remove these after the admin exists.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PERMISSIONS=
ALLOW_ADMIN_BOOTSTRAP=false
